# Keep the build context to what `npm run build` needs: package.json,
# package-lock.json, tsconfig.json, src, public (incl. icons + manifest),
# tools/build.mjs, tools/lib.mjs. Icons are pre-rendered PNGs; tools/icons.mjs
# (Playwright) never runs in the image build.
# Anything else only churns the image hash (APP_VERSION). Mirrored in
# infra/lib/constructs/service.ts (IMAGE_CONTEXT_EXCLUDE).
node_modules
dist
cdk.out
.git
.claude
.gitignore
docs
test
levels
tools/dev.mjs
tools/qa
tools/postdeploy.*
tools/icons.*
tools/release.*
tools/stats.*
tools/admin.*
tools/solve.ts
infra
cdk.json
cdk.context.json
cdk-outputs.json
vitest.config.ts
clawd-jump.tar.gz
LICENSE
**/*.md
*.log
.env
